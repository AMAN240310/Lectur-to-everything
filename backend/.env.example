# Copy to .env and adjust. All settings use the LTE_ prefix.

LTE_MONGO_URI=mongodb://localhost:27017
LTE_MONGO_DB=lecture_to_everything

# Where audio and generated PDFs are stored (default: backend/storage)
# LTE_STORAGE_DIR=C:/lecture-data

# Whisper model: tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
LTE_WHISPER_MODEL=small
# auto | cpu | cuda
LTE_WHISPER_DEVICE=auto

# Ollama + Gemma
LTE_OLLAMA_HOST=http://localhost:11434
LTE_OLLAMA_MODEL=gemma4:e2b-it-at
LTE_OLLAMA_NUM_CTX=8192

# Language the generated notes are written in (PDF export renders English best)
LTE_NOTES_LANGUAGE=English

# Optional: path to a .ttf font for PDF export (e.g. one with Devanagari glyphs)
# LTE_PDF_FONT=C:/Windows/Fonts/Nirmala.ttf
